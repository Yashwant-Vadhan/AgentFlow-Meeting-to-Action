{
  "name": "Meeting-to-Action Pipeline Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "verified-task",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook — Verified Task",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "verified-task-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.final_task.description }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Validate Task Description",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"error\": \"Bad Request\",\n  \"message\": \"final_task.description is required and cannot be empty.\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "name": "Respond 400 — Invalid Task",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        690,
        480
      ]
    },
    {
      "parameters": {
        "resource": "card",
        "operation": "create",
        "idBoard": "={{ $env.TRELLO_BOARD_ID }}",
        "idList": "={{ $env.TRELLO_LIST_ID }}",
        "name": "={{ $json.body.final_task.description.slice(0, 100) }}",
        "description": "=**Owner:** {{ $json.body.final_task.owner || 'Unassigned' }}\n**Deadline:** {{ $json.body.final_task.deadline || 'None' }}\n**Type:** {{ $json.body.final_task.type }}\n**Task ID:** {{ $json.body.final_task.id }}",
        "additionalFields": {}
      },
      "name": "Trello — Create Card",
      "type": "n8n-nodes-base.trello",
      "typeVersion": 1,
      "position": [
        690,
        220
      ],
      "credentials": {
        "trelloApi": {
          "id": "trello-credentials",
          "name": "Trello API Account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.final_task.deadline }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Check Has Deadline",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        910,
        220
      ]
    },
    {
      "parameters": {
        "calendar": "={{ $env.GOOGLE_CALENDAR_ID || 'primary' }}",
        "start": "={{ $json.body.final_task.deadline }}",
        "end": "={{ $json.body.final_task.deadline }}",
        "summary": "=Task: {{ $json.body.final_task.description }}",
        "additionalFields": {
          "description": "=Assigned to: {{ $json.body.final_task.owner || 'Unassigned' }}"
        }
      },
      "name": "Google Calendar — Create Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [
        1130,
        120
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "google-calendar-credentials",
          "name": "Google Calendar Account"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "=📋 **New Action Item Verified & Routed**\n> **Task:** {{ $json.body.final_task.description }}\n> **Owner:** {{ $json.body.final_task.owner || 'Unassigned' }}\n> **Deadline:** {{ $json.body.final_task.deadline || 'None' }}\n> **Type:** {{ $json.body.final_task.type }}"
            }
          ]
        }
      },
      "name": "Discord — Post Webhook Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1350,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"success\",\n  \"message\": \"Task routed successfully to Trello, notifications, and calendar.\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "name": "Respond 200 — Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1570,
        220
      ]
    }
  ],
  "connections": {
    "Webhook — Verified Task": {
      "main": [
        [
          {
            "node": "Validate Task Description",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Task Description": {
      "main": [
        [
          {
            "node": "Trello — Create Card",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400 — Invalid Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trello — Create Card": {
      "main": [
        [
          {
            "node": "Check Has Deadline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Has Deadline": {
      "main": [
        [
          {
            "node": "Google Calendar — Create Event",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Discord — Post Webhook Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Calendar — Create Event": {
      "main": [
        [
          {
            "node": "Discord — Post Webhook Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Discord — Post Webhook Notification": {
      "main": [
        [
          {
            "node": "Respond 200 — Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
